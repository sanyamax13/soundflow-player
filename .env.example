# Скопировать в .env, заполнить. .env в git не попадает.

# --- сервер (apps/server) ---
SOUNDFLOW_ADDR=:8090
SOUNDFLOW_ADMIN_LOGIN=alex
SOUNDFLOW_ADMIN_PASSWORD=            # пароль Alex на вход в приложение
SOUNDFLOW_JWT_SECRET=               # ключ подписи пропуска: openssl rand -hex 32
DATABASE_URL=postgres://soundflow:soundflow_dev@localhost:5433/soundflow?sslmode=disable
