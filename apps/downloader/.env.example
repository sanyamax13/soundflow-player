# === apps/python-sidecar environment ===
SIDECAR_PORT=8001
# Интерфейс прослушивания sidecar.
#   brain / default: не задавать (= 127.0.0.1) — только локально, как раньше.
#   fg Stage 2 runtime: SIDECAR_HOST=0.0.0.0 — чтобы brain достучался по
#                       http://192.168.1.73:8001 (firewall-правило 8001 на fg).
#SIDECAR_HOST=127.0.0.1

# bgutil PO Token provider URL (Docker container, see docker-compose.yml)
BGUTIL_URL=http://localhost:4416

# slskd (Soulseek) — Docker контейнер из docker-compose
SLSKD_URL=http://localhost:5030
SLSKD_API_KEY=
SLSKD_USER=
SLSKD_PASS=

# === Stage 2 path translation (runtime-near-files move на fg) ===
# LOCAL physical dirs — куда sidecar/qBT реально пишут файлы.
#   brain: E:\soundflow-data\* (это symlink на \\fg\soundflow\*)
#   fg:    D:\SoundFlow\*      (локальный диск, без SMB)
# Если не заданы — дефолты E:\soundflow-data\cache и E:\soundflow-data\music.
#TRACK_CACHE_DIR=E:\soundflow-data\cache
#ALBUMS_DIR=E:\soundflow-data\music
#
# CANONICAL dirs — пути которые sidecar ВОЗВРАЩАЕТ API (БД хранит их as-is).
# Инвариант: БД всегда canonical E:\soundflow-data\*, никогда D:\ или \\fg\.
#   brain: НЕ задавать — тогда canonical == local => translation полный no-op.
#   fg:    CANONICAL_*=E:\soundflow-data\*, а TRACK_CACHE_DIR/ALBUMS_DIR=D:\SoundFlow\*
#          sidecar пишет в D:\, но в ответ API подменяет префикс на E:\.
#CANONICAL_CACHE_DIR=E:\soundflow-data\cache
#CANONICAL_ALBUMS_DIR=E:\soundflow-data\music

# Logging
LOG_LEVEL=INFO

# YouTube cookies из браузера: 'chrome' | 'firefox' | 'edge' | '' (пусто отключает)
# С 2026 yt-dlp всё чаще ловит «Sign in to confirm you're not a bot» — cookies
# из залогиненного браузера решают проблему.
YT_COOKIES_BROWSER=chrome
